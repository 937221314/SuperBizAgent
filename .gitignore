# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.txt
coverage.html

# Go workspace file
go.work.sum

# Dependency directories (if vendoring is not intended)
# vendor/

# Build output
/bin/
/dist/
/build/
SuperBizAgent
SuperBizAgent.exe
/knowledge_cmd

# Go env / build cache artifacts
*.a
*.o

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Environment / secrets
.env
.env.*
*.local

# 本地配置文件（含密码等敏感信息），示例见 manifest/config/config.example.yaml
manifest/config/config.yaml

# eino devtools 生成的图可视化 dump（含 UI 坐标，无代码引用）
cmd/*/workflow.json
cmd/*/worflow.json
# 命令行入口的运行期知识库目录（若从命令目录自身启动）
cmd/*/docs/

# 本地开发文档（不纳入版本控制）
dev-docs/*

# 知识库文档目录，由配置项 file_dir 指向，内容为运行期数据
docs/*
# 随仓库提供的初始化知识库文档，便于新环境上手
!docs/告警处理手册.md

# Logs
*.log
logs/
