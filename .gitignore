# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.txt
coverage.html

# Go workspace file
go.work.sum

# Dependency directories (if vendoring is not intended)
# vendor/

# Build output
/bin/
/dist/
/build/
SuperBizAgent
SuperBizAgent.exe
/knowledge_cmd

# Go env / build cache artifacts
*.a
*.o

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Environment / secrets
.env
.env.*
*.local

# 本地配置文件（含密码等敏感信息），示例见 manifest/config/config.example.yaml
manifest/config/config.yaml

# eino 命令行工具的本地配置（含占位密钥）
internal/ai/cmd/*/config/config.yaml

# 本地开发文档（不纳入版本控制）
dev-docs/*

# 知识库文档目录，由 utility/common.FileDir 指向，内容为运行期数据
docs/*
!docs/.gitkeep

# 知识库命令的测试文档（运行期数据）
internal/ai/cmd/knowledge_cmd/docs/

# Logs
*.log
logs/
